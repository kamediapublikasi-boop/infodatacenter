# Salin file ini menjadi .env lalu isi nilai sesuai akun Anda.
# (File .env hanya untuk dev lokal; di Vercel pakai Environment Variables.)

# Koneksi PostgreSQL dari Supabase:
# Project Settings -> Database -> Connection string (pakai connection pooler / pooled bila ada)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres

# PIN bersama untuk aksi edit (tambah/ubah/hapus/upload gambar)
EDIT_PIN=ganti-pin-ini

# Port dev lokal (opsional)
PORT=3000
